{
  "name": "astro-takumi",
  "version": "2.0.2",
  "author": {
    "name": "Vikas Kapadiya",
    "email": "vikas@kapadiya.net",
    "url": "https://kapadiya.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikas5914/astro-takumi.git"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@takumi-rs/core": "^2.13.7",
    "@takumi-rs/helpers": "^2.13.7",
    "jsdom": "^30.0.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fontsource/roboto": "^5.3.0",
    "@oxlint/plugins": "1.82.0",
    "@tsconfig/node20": "^20.1.10",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "astro": "^7.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "bugs": {
    "url": "https://github.com/vikas5914/astro-takumi/issues"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "description": "Generate Open Graph images for your Astro site using Takumi.",
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE",
    "package-lock.json",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/vikas5914/astro-takumi",
  "keywords": [
    "takumi",
    "astro-takumi",
    "astro-integration",
    "withastro",
    "seo",
    "ui",
    "renderer"
  ],
  "license": "GPL-3.0-only",
  "lint-staged": {
    "*.{ts,tsx}": "oxlint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "printWidth": 120
  },
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest",
    "generate:presets": "mkdir -p assets/presets && npx tsx src/presets/renderExamples.ts",
    "generate:readme": "./generate_readme.sh",
    "examples:build": "npm run build && npm run build --prefix examples/preset && npm run build --prefix examples/custom"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
